{
  "name": "redactlocally",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "100% browser-local, offline PII & secrets redactor for text, code, Excel & Word before ChatGPT/Claude",
  "homepage": "https://redactlocally.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/ggbala/redactlocally.git"
  },
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:offline": "tsc --noEmit && node scripts/build-offline-html.mjs",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.511.0",
    "papaparse": "^5.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@tailwindcss/vite": "^4.1.8",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "fake-indexeddb": "^6.0.1",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-singlefile": "^2.2.0",
    "vitest": "^3.1.4"
  }
}
