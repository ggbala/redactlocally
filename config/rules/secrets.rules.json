[
  {
    "id": "private_key_block",
    "category": "secrets",
    "label": "Private Key PEM Block",
    "description": "RSA, EC, OPENSSH, or PKCS8 private key blocks in PEM format.",
    "placeholderPrefix": "PRIVATE_KEY",
    "pattern": "-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----[\\s\\S]+?-----END [A-Z0-9 ]*PRIVATE KEY-----",
    "flags": "g",
    "priority": 100,
    "validator": null,
    "enabledByDefault": true,
    "sampleMatch": "-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcw\n-----END PRIVATE KEY-----"
  },
  {
    "id": "db_conn_string",
    "category": "secrets",
    "label": "Database & Authenticated Connection URI",
    "description": "PostgreSQL, MySQL, MongoDB, Redis, AMQP, MSSQL, and HTTP/FTP URIs containing embedded credentials.",
    "placeholderPrefix": "DB_URI",
    "pattern": "\\b(?:(?:jdbc:)?(?:postgres(?:ql)?|mysql|mariadb|mongodb(?:\\+srv)?|redis(?:s)?|amqp(?:s)?|mssql|sqlserver|clickhouse|cockroachdb)|https?|ftps?):\\/\\/[^\\s\"'<>@]*:[^\\s\"'<>@]+@[^\\s\"'<>),;]+",
    "flags": "gi",
    "priority": 95,
    "validator": null,
    "enabledByDefault": true,
    "sampleMatch": "postgres://admin:Sup3rS3cret@10.0.0.12:5432/prod_db"
  },
  {
    "id": "slack_webhook",
    "category": "secrets",
    "label": "Slack / Discord Webhook URL",
    "description": "Incoming Slack and Discord webhook URLs containing secret callback tokens.",
    "placeholderPrefix": "WEBHOOK",
    "pattern": "https:\\/\\/(?:hooks\\.slack\\.com\\/services\\/T[A-Z0-9]{8,}\\/B[A-Z0-9]{8,}\\/[A-Za-z0-9]{20,}|(?:(?:ptb|canary)\\.)?discord(?:app)?\\.com\\/api\\/webhooks\\/\\d{17,20}\\/[A-Za-z0-9_-]{40,})",
    "flags": "g",
    "priority": 93,
    "validator": null,
    "enabledByDefault": true,
    "sampleMatch": "https://discord.com/api/webhooks/123456789012345678/abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGH"
  },
  {
    "id": "anthropic_key",
    "category": "secrets",
    "label": "Anthropic API Key",
    "description": "Anthropic Claude API keys beginning with sk-ant-.",
    "placeholderPrefix": "ANTHROPIC_KEY",
    "pattern": "(?<![A-Za-z0-9_-])sk-ant-(?:api\\d{2}-)?[A-Za-z0-9_-]{20,}(?![A-Za-z0-9_-])",
    "flags": "g",
    "priority": 92,
    "validator": null,
    "enabledByDefault": true,
    "sampleMatch": "sk-ant-api03-aBcDeFgHiJkLmNoPqRsTuVwXyZ0123456789"
  },
  {
    "id": "openai_key",
    "category": "secrets",
    "label": "OpenAI API Key",
    "description": "OpenAI API keys including legacy sk- and project-scoped sk-proj- tokens.",
    "placeholderPrefix": "OPENAI_KEY",
    "pattern": "(?<![A-Za-z0-9_-])sk-(?!ant-)(?:proj-|svcacct-|admin-)?[A-Za-z0-9_-]{20,}(?![A-Za-z0-9_-])",
    "flags": "g",
    "priority": 90,
    "validator": null,
    "enabledByDefault": true,
    "sampleMatch": "sk-proj-aBcDeFgHiJkLmNoPqRsTuVwXyZ0123456789"
  },
  {
    "id": "aws_access_key",
    "category": "secrets",
    "label": "AWS Access Key ID",
    "description": "Amazon Web Services IAM access key IDs (AKIA/ASIA/ABIA/ACCA).",
    "placeholderPrefix": "AWS_KEY",
    "pattern": "\\b(?:AKIA|ASIA|ABIA|ACCA)[0-9A-Z]{16}\\b",
    "flags": "g",
    "priority": 90,
    "validator": null,
    "enabledByDefault": true,
    "sampleMatch": "AKIAIOSFODNN7EXAMPLE"
  },
  {
    "id": "aws_secret_access_key",
    "category": "secrets",
    "label": "AWS Secret Access Key",
    "description": "Context-labeled 40-character AWS Secret Access Keys in config and .env files.",
    "placeholderPrefix": "AWS_KEY",
    "pattern": "\\b(?:aws[_-]?secret(?:[_-]?access)?[_-]?key)[\"']?\\s*[:=]\\s*[\"']?([A-Za-z0-9/+=]{40})[\"']?",
    "flags": "gi",
    "priority": 90,
    "validator": null,
    "enabledByDefault": true,
    "sampleMatch": "AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY",
    "captureGroup": 1
  },
  {
    "id": "github_token",
    "category": "secrets",
    "label": "GitHub Personal / OAuth Token",
    "description": "GitHub tokens (ghp_, gho_, ghu_, ghs_, ghr_, and fine-grained github_pat_).",
    "placeholderPrefix": "GITHUB_TOKEN",
    "pattern": "\\b(?:(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{22,})\\b",
    "flags": "g",
    "priority": 90,
    "validator": null,
    "enabledByDefault": true,
    "sampleMatch": "ghp_1234567890abcdefghijklmnopqrstuvwxyz"
  },
  {
    "id": "gitlab_token",
    "category": "secrets",
    "label": "GitLab Personal Access Token",
    "description": "GitLab personal, project, and group access tokens starting with glpat-.",
    "placeholderPrefix": "GITLAB_TOKEN",
    "pattern": "(?<![A-Za-z0-9_-])glpat-[A-Za-z0-9_-]{20,}(?![A-Za-z0-9_-])",
    "flags": "g",
    "priority": 90,
    "validator": null,
    "enabledByDefault": true,
    "sampleMatch": "glpat-aBcDeFgHiJkLmNoPqRsT12"
  },
  {
    "id": "stripe_key",
    "category": "secrets",
    "label": "Stripe API & Webhook Secret",
    "description": "Stripe secret, restricted, publishable, and webhook signing keys (sk_live_, rk_live_, pk_live_, whsec_).",
    "placeholderPrefix": "STRIPE_KEY",
    "pattern": "\\b(?:(?:sk|rk|pk)_(?:live|test)_[A-Za-z0-9]{16,}|whsec_[A-Za-z0-9]{24,})\\b",
    "flags": "g",
    "priority": 90,
    "validator": null,
    "enabledByDefault": true,
    "sampleMatch": "pk_test_51NxYzAbCdEfGhIjKlMnOpQrStUvWx"
  },
  {
    "id": "slack_token",
    "category": "secrets",
    "label": "Slack API Token",
    "description": "Slack bot, user, app, and refresh tokens (xoxb-, xoxp-, xoxa-, xoxr-).",
    "placeholderPrefix": "SLACK_TOKEN",
    "pattern": "(?<![A-Za-z0-9_-])xox[bpoar]-[A-Za-z0-9-]{10,}(?![A-Za-z0-9_-])",
    "flags": "g",
    "priority": 90,
    "validator": null,
    "enabledByDefault": true,
    "sampleMatch": "xoxa-2-123456789012-aBcDeFgHiJkLmNoPqRsTuVwX"
  },
  {
    "id": "google_api_key",
    "category": "secrets",
    "label": "Google / GCP API Key",
    "description": "Google Cloud Platform and Firebase API keys starting with AIza.",
    "placeholderPrefix": "GCP_KEY",
    "pattern": "(?<![A-Za-z0-9_-])AIza[0-9A-Za-z\\-_]{35}(?![A-Za-z0-9_-])",
    "flags": "g",
    "priority": 90,
    "validator": null,
    "enabledByDefault": true,
    "sampleMatch": "AIzaSyDaGmWKa4JsXZ-HjGw7ISLn_3namBGewQe"
  },
  {
    "id": "sendgrid_key",
    "category": "secrets",
    "label": "SendGrid API Key",
    "description": "Twilio SendGrid API keys formatted as SG.<id>.<secret>.",
    "placeholderPrefix": "SENDGRID_KEY",
    "pattern": "(?<![A-Za-z0-9_.-])SG\\.[A-Za-z0-9_-]{16,}\\.[A-Za-z0-9_-]{24,}(?![A-Za-z0-9_-])",
    "flags": "g",
    "priority": 90,
    "validator": null,
    "enabledByDefault": true,
    "sampleMatch": "SG.0123456789abcdef1234.0123456789abcdefghijklmnopqrstuvwxyz"
  },
  {
    "id": "huggingface_token",
    "category": "secrets",
    "label": "Hugging Face Access Token",
    "description": "Hugging Face user and organization access tokens beginning with hf_.",
    "placeholderPrefix": "HF_TOKEN",
    "pattern": "(?<![A-Za-z0-9_-])hf_[A-Za-z0-9]{25,}(?![A-Za-z0-9_-])",
    "flags": "g",
    "priority": 90,
    "validator": null,
    "enabledByDefault": true,
    "sampleMatch": "hf_aBcDeFgHiJkLmNoPqRsTuVwXyZ012345"
  },
  {
    "id": "npm_token",
    "category": "secrets",
    "label": "npm Access Token",
    "description": "npm registry granular and automation access tokens beginning with npm_.",
    "placeholderPrefix": "NPM_TOKEN",
    "pattern": "(?<![A-Za-z0-9_-])npm_[A-Za-z0-9]{30,}(?![A-Za-z0-9_-])",
    "flags": "g",
    "priority": 90,
    "validator": null,
    "enabledByDefault": true,
    "sampleMatch": "npm_aBcDeFgHiJkLmNoPqRsTuVwXyZ0123456789"
  },
  {
    "id": "jwt_token",
    "category": "secrets",
    "label": "JSON Web Token (JWT)",
    "description": "Three-segment Base64URL JSON Web Tokens (header.payload.signature).",
    "placeholderPrefix": "JWT",
    "pattern": "(?<![A-Za-z0-9_-])eyJ[A-Za-z0-9_-]{6,}\\.eyJ[A-Za-z0-9_-]{6,}\\.[A-Za-z0-9_-]{8,}(?![A-Za-z0-9_-])",
    "flags": "g",
    "priority": 88,
    "validator": null,
    "enabledByDefault": true,
    "sampleMatch": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkFsaWNlIn0.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c"
  },
  {
    "id": "http_auth_cred",
    "category": "secrets",
    "label": "HTTP Basic Auth & cURL Credentials",
    "description": "Base64 HTTP Basic Authorization headers and curl -u / --user user:password pairs.",
    "placeholderPrefix": "AUTH_CRED",
    "pattern": "(?:\\bAuthorization[\"']?\\s*[:=]\\s*[\"']?Basic\\s+|(?:^|\\s)(?:-u|--user)\\s+[\"']?)([A-Za-z0-9._-]+:[^\\s\"']{4,}|[A-Za-z0-9+/=]{12,})(?![A-Za-z0-9+/=])",
    "flags": "gi",
    "priority": 85,
    "validator": null,
    "enabledByDefault": true,
    "sampleMatch": "Authorization: Basic dXNlcjpwYXNzd29yZA==",
    "captureGroup": 1
  },
  {
    "id": "generic_secret_quoted",
    "category": "secrets",
    "label": "Quoted Password / Secret / Key Value",
    "description": "Quoted string secrets in JSON, YAML, JS/TS, or Python assigned to password, passphrase, secret, token, or key fields (preserves code expressions and env references).",
    "placeholderPrefix": "SECRET",
    "pattern": "\\b(?:[A-Za-z0-9_.-]{0,24}(?:api[_-]?key|secret(?:[_-]?key)?|signing[_-]?key|encryption[_-]?key|master[_-]?key|private[_-]?key|access[_-]?key|auth[_-]?key|password|passwd|passphrase|access[_-]?token|auth[_-]?token|refresh[_-]?token|client[_-]?secret|private[_-]?token|token|(?:db|user|admin|root|auth|smtp|mail|redis|mysql|pg|sql|ftp|ssh|login|client|app|hardcoded)pass)|(?:[A-Za-z0-9_.-]{0,20}[_-])?(?:pass|pwd))(?:[_-]?(?:val(?:ue)?|real|prod|live))?[\"']?\\s*[:=]\\s*([\"'])((?!\\$\\{|\\{\\{|<[^>]+>|\\[[A-Z0-9_]+_\\d+\\]|(?:true|false|null|none|undefined|changeme|placeholder|example|your[_-][a-z_-]+|string|password|bearer)\\1)(?:(?!\\1)[^\\r\\n]){6,128})\\1",
    "flags": "gi",
    "priority": 72,
    "validator": null,
    "enabledByDefault": true,
    "sampleMatch": "\"password\": \"P@ss:word;99!\"",
    "captureGroup": 2
  },
  {
    "id": "generic_secret_kv",
    "category": "secrets",
    "label": "Unquoted Config Secret / Password / Bearer Token",
    "description": "Unquoted secrets in .env, YAML, INI, or HTTP Bearer headers (ignores code references like process.env, os.environ, and function calls).",
    "placeholderPrefix": "SECRET",
    "pattern": "(?:\\bBearer\\s+|\\b(?:[A-Za-z0-9_.-]{0,24}(?:api[_-]?key|secret(?:[_-]?key)?|signing[_-]?key|encryption[_-]?key|master[_-]?key|private[_-]?key|access[_-]?key|auth[_-]?key|password|passwd|passphrase|access[_-]?token|auth[_-]?token|refresh[_-]?token|client[_-]?secret|private[_-]?token|token|(?:db|user|admin|root|auth|smtp|mail|redis|mysql|pg|sql|ftp|ssh|login|client|app|hardcoded)pass)|(?:[A-Za-z0-9_.-]{0,20}[_-])?(?:pass|pwd))(?:[_-]?(?:val(?:ue)?|real|prod|live))?\\s*[:=]\\s*)(?!(?:true|false|null|none|undefined|changeme|placeholder|string|number|boolean|optional|process\\.|os\\.|req\\.|ctx\\.|this\\.|self\\.|config\\.|settings\\.|env\\.|system\\.|\\$\\{|\\{\\{|[\"']))([A-Za-z0-9._~+/@!#$%^&*=-]{6,})(?![A-Za-z0-9._~+/@!#$%^&*=-]|\\s*\\(|\\[)",
    "flags": "gi",
    "priority": 70,
    "validator": null,
    "enabledByDefault": true,
    "sampleMatch": "API_KEY=prod_secret_9876543210",
    "captureGroup": 1
  }
]
