[
  {
    "id": "credit_card",
    "category": "financial",
    "label": "Credit / Debit Card Number",
    "description": "13–19 digit payment card numbers (Visa, Mastercard, Amex, Discover, JCB, Diners, UnionPay, Maestro) verified with IIN prefix and Luhn checksum.",
    "placeholderPrefix": "CARD",
    "pattern": "(?<![A-Za-z0-9-])(?:\\d{4}-\\d{4}-\\d{4}-\\d{4}(?:-\\d{1,3})?|\\d{4} \\d{4} \\d{4} \\d{4}(?: \\d{1,3})?|\\d{4}-\\d{6}-\\d{4,5}|\\d{4} \\d{6} \\d{4,5}|\\d{13,19})(?![A-Za-z0-9-])",
    "flags": "g",
    "priority": 85,
    "validator": "luhn",
    "enabledByDefault": true,
    "sampleMatch": "4532-0151-1283-0366"
  },
  {
    "id": "iban",
    "category": "financial",
    "label": "IBAN Bank Account",
    "description": "International Bank Account Numbers (including 1-char final groups like CH/PT/LV) validated against ISO 13616 lengths and ISO 7064 Mod-97.",
    "placeholderPrefix": "IBAN",
    "pattern": "\\b[A-Z]{2}\\d{2}(?:(?:[\\s-][A-Z0-9]{2,4}){2,7}[\\s-][A-Z0-9]{1,4}|[A-Z0-9]{11,30})\\b",
    "flags": "g",
    "priority": 85,
    "validator": "iban",
    "enabledByDefault": true,
    "sampleMatch": "DE89 3704 0044 0532 0130 00"
  },
  {
    "id": "swift_bic",
    "category": "financial",
    "label": "SWIFT / BIC Bank Code",
    "description": "Context-labeled 8- or 11-character uppercase SWIFT/BIC bank identifier codes.",
    "placeholderPrefix": "BIC",
    "pattern": "\\b(?:SWIFT|Swift|swift|BIC|Bic|bic|Bank\\s+Identifier\\s+Code)(?:\\s*\\/\\s*(?:SWIFT|Swift|swift|BIC|Bic|bic))?(?:\\s+(?:Code|code|No\\.?|no\\.?|Number|number))?\\s*[:#=-]?\\s*([A-Z]{4}[A-Z]{2}[A-Z0-9]{2}(?:[A-Z0-9]{3})?)\\b",
    "flags": "g",
    "priority": 75,
    "validator": null,
    "enabledByDefault": true,
    "sampleMatch": "SWIFT: DEUTDEFF500",
    "captureGroup": 1
  }
