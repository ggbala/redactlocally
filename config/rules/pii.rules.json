[
  {
    "id": "email",
    "category": "pii",
    "label": "Email Address",
    "description": "Standard RFC-style email addresses with alphabetic/punycode TLDs (excludes package versions like react@19.1.0).",
    "placeholderPrefix": "EMAIL",
    "pattern": "\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*\\.(?:xn--[A-Za-z0-9-]{2,24}|[A-Za-z]{2,24})\\b",
    "flags": "g",
    "priority": 80,
    "validator": null,
    "enabledByDefault": true,
    "sampleMatch": "alice.smith@acme-corp.com"
  },
  {
    "id": "phone_intl",
    "category": "pii",
    "label": "Phone Number (US / EU / Intl)",
    "description": "International (+CC) and formatted NANP/EU telephone numbers with safeguards against decimal deltas and plain numeric table rows.",
    "placeholderPrefix": "PHONE",
    "pattern": "(?<![A-Za-z0-9+\\-])(?:\\+[1-9]\\d{0,2}(?:[\\s-](?:\\(\\d{1,4}\\)[\\s-]?)?(?:\\d[\\s-]?){6,13}\\d|\\.(?:\\d{1,4}\\.){2,4}\\d{2,4}|\\(\\d{1,4}\\)[\\s.-]?(?:\\d[\\s.-]?){6,12}\\d)|(?:1[\\s.-])?(?:\\([2-9]\\d{2}\\)[\\s.-]?[2-9]\\d{2}[\\s.-]\\d{4}|[2-9]\\d{2}-[2-9]\\d{2}-\\d{4}|[2-9]\\d{2}\\.[2-9]\\d{2}\\.\\d{4}))(?![A-Za-z0-9\\-])",
    "flags": "g",
    "priority": 65,
    "validator": null,
    "enabledByDefault": true,
    "sampleMatch": "+1-415-555-0199"
  },
  {
    "id": "ssn_us",
    "category": "pii",
    "label": "US Social Security Number (SSN)",
    "description": "US SSN in XXX-XX-XXXX format validated against invalid SSA area/group/serial ranges.",
    "placeholderPrefix": "SSN",
    "pattern": "(?<![A-Za-z0-9-])\\d{3}-\\d{2}-\\d{4}(?![A-Za-z0-9-])",
    "flags": "g",
    "priority": 85,
    "validator": "ssn",
    "enabledByDefault": true,
    "sampleMatch": "123-45-6789"
  },
  {
    "id": "passport_id",
    "category": "pii",
    "label": "Passport & National ID Number",
    "description": "Context-labeled passport, national ID, and driver's license identifiers.",
    "placeholderPrefix": "ID_NUM",
    "pattern": "\\b(?:passport(?:\\s+(?:no\\.?|num(?:ber)?|id|#))?|national\\s+id(?:\\s+(?:no\\.?|num(?:ber)?|#))?|id\\s+(?:no\\.?|number)|driver(?:'s)?\\s+licen[cs]e(?:\\s+(?:no\\.?|num(?:ber)?|#))?)\\s*[:#=-]?\\s*([A-Z]{1,2}\\d{6,9}|\\d{8,9})\\b",
    "flags": "gi",
    "priority": 75,
    "validator": null,
    "enabledByDefault": true,
    "sampleMatch": "Passport No: AB1234567",
    "captureGroup": 1
  }
]
